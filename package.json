{
  "name": "penta-coop-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://www.pentacoop.com",
  "license": "MIT",
  "scripts": {
    "dev": "npm run build && eleventy --serve --port=8080",
    "build": "npm run clean && npm run build:css && eleventy && node -e \"require('fs').copyFileSync('dist/index.html','dist/404.html')\"",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:css": "tailwindcss -i src/index.css -o site/assets/site.css --minify",
    "lint": "eslint .eleventy.js site/assets/site.js",
    "preview": "eleventy --serve --port=8080",
    "prepreview": "npm run build",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@eslint/js": "^9.9.0",
    "@tailwindcss/typography": "^0.5.15",
    "@types/node": "^22.5.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.4",
    "gh-pages": "^6.3.0",
    "globals": "^15.9.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.59.4"
  }
}
