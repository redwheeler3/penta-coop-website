<form class="space-y-4" novalidate data-email-signup data-consent-version="2026-08-27" data-form-name="{{ site.mailingList.name }}" data-submit-url="{{ site.mailingList.submitUrl }}">
  <div><label for="email" class="text-sm font-medium leading-none">Email Address</label><input id="email" type="email" name="email" required autocomplete="email" placeholder="your.email@example.com" class="mt-2 flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm"></div>
  <fieldset><legend class="text-sm font-medium leading-none">Unit Preference</legend><div class="space-y-2 mt-2">
    <label class="flex items-center gap-3 text-sm leading-5"><input type="checkbox" name="unitSize" value="1" class="h-4 w-4 shrink-0 rounded border-gray-300 text-green-600 focus:ring-green-600"><span>1 bedroom, 1 or 2 adults</span></label>
    <label class="flex items-center gap-3 text-sm leading-5"><input type="checkbox" name="unitSize" value="2" class="h-4 w-4 shrink-0 rounded border-gray-300 text-green-600 focus:ring-green-600"><span>2 bedroom, 1 or 2 adults plus 1 or more children under 18</span></label>
    <label class="flex items-center gap-3 text-sm leading-5"><input type="checkbox" name="unitSize" value="3" class="h-4 w-4 shrink-0 rounded border-gray-300 text-green-600 focus:ring-green-600"><span>3 bedroom, 1 or 2 adults plus 2 or more children under 18</span></label>
  </div></fieldset>
  <p hidden data-signup-status role="status" aria-live="polite" class="rounded-lg border px-4 py-3 text-sm leading-relaxed"></p>
  <div class="text-center pt-2"><button type="submit" class="inline-flex items-center justify-center bg-orange-700 hover:bg-orange-800 text-white text-lg px-8 py-3 rounded-md font-medium"><span hidden data-submit-spinner class="signup-spinner mr-2" aria-hidden="true"></span><svg data-submit-icon class="h-5 w-5 mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a2 2 0 0 1-2.06 0L2 7"/></svg><span data-submit-label>Subscribe for Updates</span></button></div>
</form>
