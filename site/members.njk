<main class="min-h-screen bg-gradient-to-br from-green-50 to-emerald-100">
  {% include "navigation.njk" %}
  <div class="max-w-4xl mx-auto px-4 py-12">
    <header class="text-center mb-12"><h1 class="text-4xl font-bold text-gray-900 mb-4">Members Area</h1><p class="text-lg text-gray-600">Access member resources, documents, and community discussions</p></header>
    <div class="grid md:grid-cols-2 md:items-start gap-6">
      {% for resource in [{title:'File Repository',description:'Access documents on Google Drive',icon:'file',links:[{t:'Meeting Minutes',u:'https://drive.google.com/drive/folders/1kyVTEUvDEYy4XcnayWsV2KisZ44CRXgE?usp=drive_link'},{t:'Management Reports',u:'https://drive.google.com/drive/folders/16Bjujq-0VlEEJCqToI52RMbnJ5cuglc7?usp=drive_link'},{t:'Bylaws & Policies',u:'https://drive.google.com/drive/folders/1O2zb24edHeVHKLkTu5lSM0MthMccnLPF?usp=drive_link'},{t:'Maintenance Guidelines',u:'https://drive.google.com/file/d/1rrVl4VSP6l_aYXTpOXV2BHY3TA55Qrhk/view?usp=drive_link'},{t:'Complaint Form',u:'https://docs.google.com/file/d/1D1cubBrqwal2Ok4t7aCH3Yiw-n25R8Mh/view?usp=drive_link'},{t:'Committee Composition',u:'https://drive.google.com/file/d/1Nv9Pnb6EaHvZAJfMew0LFQs8YBbwu_b9/view?usp=drive_link'},{t:'Browse All Files',u:'https://files.pentacoop.com'}]},{title:'Community Forum',description:'Join discussions with other members on Discord',icon:'message',links:[{t:'Sign Up',u:'https://discord.gg/yJRGzyCT5B'},{t:'Join Discussion',u:'https://discord.com/channels/1415940719276855380/1415940719813595220'}]}] %}
      <section class="bg-white shadow-lg hover:shadow-xl transition-shadow flex flex-col rounded-lg border border-gray-200"><div class="p-6"><div class="flex items-center mb-2"><svg class="h-6 w-6 text-green-600 mr-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">{% if resource.icon == 'file' %}<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/>{% else %}<path d="M21 11.5a8.4 8.4 0 0 1-9 8.5 9 9 0 0 1-4-1l-5 1 1.5-4A8.4 8.4 0 0 1 3 11.5a9 9 0 0 1 18 0Z"/>{% endif %}</svg><h2 class="text-lg font-semibold">{{ resource.title }}</h2><svg class="h-4 w-4 text-gray-400 ml-auto" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M21 14v6a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h6"/></svg></div><p class="text-sm text-gray-600">{{ resource.description }}</p></div><div class="px-6 pb-6 flex-1"><div class="space-y-2 md:grid md:grid-cols-2 md:gap-3 md:space-y-0">{% for link in resource.links %}<a href="{{ link.u }}" target="_blank" rel="noopener noreferrer" data-resource-category="{{ resource.title }}" class="flex items-center justify-center gap-2 w-full bg-green-600 hover:bg-green-700 text-white rounded-md px-3 py-2 text-sm font-medium{% if link.t == 'Committee Composition' %} md:col-span-2 whitespace-nowrap{% endif %}">{{ link.t }}</a>{% endfor %}</div></div></section>
      {% endfor %}
    </div>
    <section class="mt-12 bg-white rounded-lg shadow-lg p-6"><h2 class="text-2xl font-bold text-gray-900 mb-4">Need Help?</h2><div class="grid md:grid-cols-2 gap-6"><div><h3 class="font-semibold text-lg mb-2">Member Technical Assistance</h3><p class="text-gray-600 mb-2">For help with accessing Google Drive or Discord, or for technical support with the website:</p><p class="text-sm mb-4"><strong>Email:</strong> <a href="mailto:techsupport@pentacoop.com" target="_blank" rel="noopener noreferrer" class="text-green-600 hover:underline">techsupport@pentacoop.com</a></p><div class="mb-4 border-b"><button type="button" data-accordion-name="TELUS Email Help" aria-controls="telus-help" aria-expanded="false" class="w-full flex items-center justify-between text-left font-medium text-sm py-4">TELUS Email Users: Accessing File Repository Documents <span aria-hidden="true">⌄</span></button><div id="telus-help" hidden class="pb-4"><div class="bg-blue-50 border border-blue-200 rounded-lg p-3"><div class="space-y-2 text-sm text-blue-700"><div class="mb-3 p-2 bg-blue-100 rounded text-xs"><strong>Follow these steps if you have a TELUS email account and get an "access denied" message when trying to view File Repository documents.</strong></div><div><strong>Step 1:</strong> Go to <a href="https://mail.google.com" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline">mail.google.com</a> (your TELUS email)</div><div><strong>Step 2:</strong> Click your profile picture (or the circle with your initial) in the top right corner</div><div><strong>Step 3:</strong> If you have a personal Gmail account listed, select it and skip to Step 6</div><div><strong>Step 4:</strong> If you don't see a personal account, click "Add another account"</div><div><strong>Step 5:</strong> Sign in with an existing personal Gmail, or click "Create account" to make a new one</div><div><strong>Step 6:</strong> Once signed in with your personal account, try accessing the File Repository links again</div><div class="mt-2 p-2 bg-blue-100 rounded text-xs"><strong>Note:</strong> TELUS email accounts have restricted access to external shared folders. A personal Google/Gmail account is required to view the co-op documents.</div></div></div></div></div></div><div><h3 class="font-semibold text-lg mb-2">Member Maintenance Issues</h3><div class="mb-4"><h4 class="font-medium text-green-700 mb-1"><a href="https://www.tpmmanagement.ca" target="_blank" rel="noopener noreferrer" class="text-green-700 hover:text-green-800 hover:underline">TPM Real Estate Management</a></h4><p class="text-gray-600 mb-2">Contact for all maintenance issues:</p><div class="space-y-1"><p class="text-sm"><strong>Phone:</strong> <a href="tel:604-736-8775" class="text-green-600 hover:underline">(604) 736-8775</a></p><p class="text-sm"><strong>Email:</strong> <a href="mailto:tpm_maintenance@tpmmanagement.ca" target="_blank" rel="noopener noreferrer" class="text-green-600 hover:underline">tpm_maintenance@tpmmanagement.ca</a></p></div></div><div class="bg-red-50 border border-red-200 rounded-lg p-3"><h4 class="font-medium text-red-800 mb-1">Emergency After Hours</h4><p class="text-sm text-red-700 mb-1">For urgent emergencies only (evenings/weekends):</p><p class="text-sm"><strong>Emergency Line:</strong> <a href="tel:604-736-1157" class="text-red-600 hover:underline">(604) 736-1157</a></p></div></div></div></section>
  </div>
</main>
